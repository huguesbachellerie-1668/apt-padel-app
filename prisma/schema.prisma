generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                  String         @id @default(cuid())
  email               String?        @unique
  phone               String?
  password            String?
  name                String
  nickname            String?
  role                String         @default("JOUEUR")
  points              Float          @default(0)
  averagePoints       Float          @default(0)
  totalMatches        Int            @default(0)
  yellowCards         Int            @default(0)
  redCards            Int            @default(0)
  tops                Int            @default(0)
  flops               Int            @default(0)
  createdAt           DateTime       @default(now())
  historicalStats     Json?          @default("{}")
  lastCalculatedLevel Int?
  lastNewsSeenAt      DateTime?
  stars               Int            @default(0)
  team1Player1Matches Match[]        @relation("Team1Player1")
  team1Player2Matches Match[]        @relation("Team1Player2")
  team2Player1Matches Match[]        @relation("Team2Player1")
  team2Player2Matches Match[]        @relation("Team2Player2")
  poolPlayers         PoolPlayer[]
  registrations       Registration[]

  @@index([averagePoints(sort: Desc)])
}

model Season {
  id        String    @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean   @default(false)
  sessions  Session[]
}

model Session {
  id                String             @id @default(cuid())
  seasonId          String
  date              DateTime
  registrationOpen  DateTime?
  registrationClose DateTime?
  status            String             @default("PREVUE")
  courts            Int                @default(0)
  isCounted         Boolean            @default(true)
  activityLogs      ActivityLog[]
  reservations      CourtReservation[]
  pools             Pool[]
  registrations     Registration[]
  season            Season             @relation(fields: [seasonId], references: [id])

  @@index([seasonId])
}

model Registration {
  id                    String   @id @default(cuid())
  userId                String
  sessionId             String
  status                String   @default("INSCRIT")
  isReturningFromInjury Boolean  @default(false)
  createdAt             DateTime @default(now())
  session               Session  @relation(fields: [sessionId], references: [id])
  user                  User     @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@index([userId])
  @@unique([userId, sessionId])
}

model Pool {
  id                 String            @id @default(cuid())
  sessionId          String
  courtNumber        Int
  level              Int
  startTime          String?
  courtReservationId String?           @unique
  matches            Match[]
  courtReservation   CourtReservation? @relation(fields: [courtReservationId], references: [id])
  session            Session           @relation(fields: [sessionId], references: [id])
  players            PoolPlayer[]

  @@index([sessionId])
}

model PoolPlayer {
  poolId String
  userId String
  seed   Int
  pool   Pool   @relation(fields: [poolId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([poolId])
  @@index([userId])
  @@unique([poolId, userId])
}

model Match {
  id             String @id @default(cuid())
  poolId         String
  order          Int
  team1Player1Id String
  team1Player2Id String
  team2Player1Id String
  team2Player2Id String
  team1Games     Int?
  team2Games     Int?
  winningTeam    Int?
  pool           Pool   @relation(fields: [poolId], references: [id])
  team1Player1   User   @relation("Team1Player1", fields: [team1Player1Id], references: [id])
  team1Player2   User   @relation("Team1Player2", fields: [team1Player2Id], references: [id])
  team2Player1   User   @relation("Team2Player1", fields: [team2Player1Id], references: [id])
  team2Player2   User   @relation("Team2Player2", fields: [team2Player2Id], references: [id])

  @@index([poolId])
  @@index([team1Player1Id])
  @@index([team1Player2Id])
  @@index([team2Player1Id])
  @@index([team2Player2Id])
}

model Club {
  id           String             @id @default(cuid())
  name         String
  city         String
  address      String
  reservations CourtReservation[]
}

model CourtReservation {
  id               String  @id @default(cuid())
  sessionId        String
  clubId           String
  name             String
  startTime        String
  defaultPoolLevel Int?
  club             Club    @relation(fields: [clubId], references: [id])
  session          Session @relation(fields: [sessionId], references: [id])
  pool             Pool?

  @@index([clubId])
  @@index([sessionId])
}

model News {
  id       String   @id @default(cuid())
  title    String
  content  String
  date     DateTime @default(now())
  isActive Boolean  @default(true)
}

model Sponsor {
  id       String  @id @default(cuid())
  name     String
  logoUrl  String?
  website  String?
  isActive Boolean @default(true)
}

model Goodie {
  id          String  @id @default(cuid())
  name        String
  description String?
  price       Float
  imageUrl    String?
  isActive    Boolean @default(true)
}

model Settings {
  id                 String @id @default("global")
  matchDuration      Int    @default(25)
  lockUnregisterDay  Int    @default(5)
  lockUnregisterTime String @default("20:00")
}

model ActivityLog {
  id        String   @id @default(cuid())
  sessionId String
  message   String
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}
